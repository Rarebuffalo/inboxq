			"name": "Operational Analytics Stats",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/analytics/stats",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"analytics",
						"stats"
					]
				},
				"description": "Fetches active ticket counts grouped by categories, priorities, open states, and average confidence levels."
			},
			"response": []
		},
		{
			"name": "CSV Export Queue",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/tickets/export?category=access_issue",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"tickets",
						"export"

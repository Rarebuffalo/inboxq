	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				},
				"description": "Reports liveness, SQLite connection state, Gemini configuration, heuristics state, and active P0/P1 warning counts."
			},
			"response": []
		},
		{
			"name": "Classify & Ingest Email",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email_id\": \"resident.alert@gmail.com\",\n  \"title\": \"Fingerprint scanner fails on right thumb\",\n  \"body\": \"I am standing at the society vault kiosk and the biometric reader keeps returning error scans for my register thumb. I need my tray to lock. Urgent support requested.\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/tickets/classify",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"tickets",
						"classify"
					]
				},
				"description": "Submits a support email payload to the classification engine. Performs duplicate SHA-256 hash checks, routes queues, and sets SLA deadlines."
			},
			"response": []
		},
		{
			"name": "List Tickets Queue",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/tickets?search=fingerprint&category=access_issue&priority=P0&sort_by=created_at&sort_order=desc",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"tickets"
					],
					"query": [
						{
							"key": "search",
							"value": "fingerprint"
						},
						{
							"key": "category",
							"value": "access_issue"
						},
						{
							"key": "priority",
							"value": "P0"
						},
						{
							"key": "sort_by",
							"value": "created_at"
						},
						{
							"key": "sort_order",
							"value": "desc"
						}
					]
				},
				"description": "Lists support tickets queue matching criteria, status, priority, sorting patterns, and pagination offsets."
			},
			"response": []
		},
		{
			"name": "Get Ticket Detail",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/tickets/1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"tickets",
						"1"
					]
				},
				"description": "Retrieves detail parameters for a single ticket, including explainable AI logs and the full timeline transition log list."
			},
			"response": []
		},
		{
			"name": "Manual Override Action",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"category\": \"security_emergency\",\n  \"priority\": \"P0\",\n  \"status\": \"investigating\",\n  \"assigned_to\": \"agent_smith\",\n  \"draft_reply\": \"Manual confirmation of security check. Responder dispatched.\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/tickets/1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"tickets",
						"1"
					]
				},
				"description": "Applies operational adjustments (overrides category, priority, assignee, status, draft replies) and records modifications to the ticket timeline logs."
			},
			"response": []
		},

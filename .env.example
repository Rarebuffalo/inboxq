# Server Configurations
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database Configurations
# SQLite database path. For production this would point to a persistent directory.
DATABASE_URL=sqlite:///./tickets.db

# AI & Classification Configurations
# Optional: Add your Google Gemini API key here to enable LLM-based classification.
# If left empty, the application will fallback to heuristic-based local classification.
GEMINI_API_KEY=
